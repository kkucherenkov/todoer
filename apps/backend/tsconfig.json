{
  "extends": "../../tsconfig.base.json",
  // Everything, specs and root-level config included: this is what `typecheck`
  // and ESLint's type-aware rules read. `build` uses tsconfig.build.json.
  "compilerOptions": {
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src", "*.ts"]
}
