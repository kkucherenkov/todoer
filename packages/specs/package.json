{
  "name": "@todoer/specs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors/*.json": "./vectors/*.json"
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "validate": "redocly lint openapi/openapi.yaml",
    "codegen": "openapi-ts",
    "build": "pnpm codegen && tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.0",
    "@redocly/cli": "^1.25.0",
    "@types/node": "^24",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^5.0.2"
  }
}
