{
  "name": "@todoer/specs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "validate": "redocly lint openapi/openapi.yaml",
    "codegen": "openapi-ts",
    "build": "pnpm codegen && tsup src/generated/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.0",
    "@redocly/cli": "^1.25.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
