{
  "name": "@todoer/client-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node-sqlite": {
      "types": "./dist/node-sqlite.d.ts",
      "default": "./dist/node-sqlite.js"
    },
    "./sqlite-wasm": {
      "types": "./dist/sqlite-wasm.d.ts",
      "default": "./dist/sqlite-wasm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@todoer/specs": "workspace:^"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "@types/node": "^24",
    "typescript": "^5.6.3",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1"
  },
  "peerDependenciesMeta": {
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    }
  }
}
